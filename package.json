{
  "name": "split-bill-download",
  "version": "1.0.0",
  "description": "Download page for Split Bill Expo App",
  "main": "server.js",
  "scripts": {
    "start":  "node server.js",
    "server": "nodemon server.js",
    "client": "npm run dev --prefix client",
    "dev":    "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "express":  "^4.18.2",
    "cors":     "^2.8.5",
    "dotenv":   "^16.3.1",
    "path":     "^0.12.7"
  },
  "devDependencies": {
    "nodemon":      "^3.0.1",
    "concurrently": "^8.2.1"
  }
}
